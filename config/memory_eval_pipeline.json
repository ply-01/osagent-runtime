{
  "schema_version": 1,
  "sources": [],
  "manifest_output": "artifacts/evaluation/manifest.json",
  "report_output": "artifacts/evaluation/report.md",
  "jobs": [
    {
      "id": "track1",
      "enabled": true,
      "system": "OSAgent Runtime",
      "dataset": "public synthetic maintenance handover",
      "dataset_revision": "1",
      "evaluation_role": "functional simulation",
      "metric_scope": "Explicit workflow checks, not production accuracy or competition score",
      "output": "artifacts/evaluation/scenario.json",
      "command": [
        "{python}",
        "scripts/evaluate-track1.py",
        "--output",
        "{output}"
      ],
      "metrics": [
        {
          "id": "checks_passed",
          "label": "Workflow checks passed",
          "path": "checks_passed",
          "threshold": {
            "min": 10
          },
          "competition_metric": false
        }
      ]
    }
  ]
}

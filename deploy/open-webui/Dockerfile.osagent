FROM ghcr.io/astral-sh/uv:0.12.1-python3.11-trixie-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    UV_LINK_MODE=copy

WORKDIR /opt/osagent

COPY pyproject.toml README.md ./
COPY src ./src

RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system . \
    && useradd --create-home --uid 10001 osagent \
    && mkdir -p /data/memory /workspace \
    && chown -R osagent:osagent /data /workspace

WORKDIR /data
USER osagent

ENTRYPOINT ["os-agent-web"]

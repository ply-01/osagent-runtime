[Unit]
Description=OSagent native memory and MCP service
Documentation=https://github.com/Amen-ai36/OSagent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/osagent/osagent-memory.env
PassEnvironment=DISPLAY WAYLAND_DISPLAY XAUTHORITY DBUS_SESSION_BUS_ADDRESS XDG_RUNTIME_DIR
WorkingDirectory=%h/.local/share/osagent
ExecStart=%h/.local/share/osagent/venv/bin/os-agent-web
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=false
ProtectSystem=full
UMask=0077

[Install]
WantedBy=default.target

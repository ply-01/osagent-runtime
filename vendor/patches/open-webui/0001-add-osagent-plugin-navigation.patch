diff --git a/src/routes/(app)/workspace/plugins/+page.svelte b/src/routes/(app)/workspace/plugins/+page.svelte
new file mode 100644
index 0000000..a8bbf03
--- /dev/null
+++ b/src/routes/(app)/workspace/plugins/+page.svelte
@@ -0,0 +1,672 @@
+<script lang="ts">
+	import { onMount, getContext } from 'svelte';
+	import { goto } from '$app/navigation';
+	import { toast } from 'svelte-sonner';
+	import { getTools } from '$lib/apis/tools';
+	import {
+		getToolServerConnections,
+		initiateOAuthRedirect,
+		registerOAuthClient,
+		setToolServerConnections,
+		verifyToolServerConnection
+	} from '$lib/apis/configs';
+	import Search from '$lib/components/icons/Search.svelte';
+	import Refresh from '$lib/components/icons/Refresh.svelte';
+	import Settings from '$lib/components/icons/Settings.svelte';
+	import Plus from '$lib/components/icons/Plus.svelte';
+	import ChevronDown from '$lib/components/icons/ChevronDown.svelte';
+	import Trash from '$lib/components/icons/Trash.svelte';
+	import Spinner from '$lib/components/common/Spinner.svelte';
+
+	const i18n: any = getContext('i18n');
+	let loading = true;
+	let busy = '';
+	let query = '';
+	let selectedCategory = '全部';
+	let items: any[] = [];
+	let apiKey = '';
+	let needsKey = false;
+	let showSettings = false;
+	let toolConnections: any[] = [];
+	let availableTools: any[] = [];
+	let canManageConnections = true;
+	let integrationsReady = false;
+	let searchTimer: ReturnType<typeof setTimeout> | undefined;
+	let integrationRetryTimer: ReturnType<typeof setTimeout> | undefined;
+
+	$: installed = items.filter((item) => item.installed);
+	$: available = items.filter((item) => !item.installed);
+	$: categories = [
+		'全部',
+		...Array.from(new Set(items.map((item) => categoryFor(item)).filter(Boolean))).filter(
+			(category) => category !== '全部'
+		)
+	];
+	$: filtered = items.filter((item) => {
+		const needle = query.trim().toLowerCase();
+		const categoryMatches = selectedCategory === '全部' || categoryFor(item) === selectedCategory;
+		const searchable = [
+			item.name,
+			item.display_name,
+			item.description,
+			item.category,
+			item.author,
+			...(item.permissions ?? [])
+		];
+		const textMatches =
+			!needle ||
+			searchable.some((value) =>
+				String(value ?? '')
+					.toLowerCase()
+					.includes(needle)
+			);
+		return categoryMatches && textMatches;
+	});
+	$: filteredAvailable = filtered.filter((item) => !item.installed);
+	$: featured = filteredAvailable.filter((item) => item.featured).slice(0, 4);
+	$: featuredNames = new Set(featured.map((item) => item.name));
+	$: groupedAvailable = Array.from(
+		filteredAvailable.reduce((groups, item) => {
+			const category = categoryFor(item);
+			const group = groups.get(category) ?? [];
+			group.push(item);
+			groups.set(category, group);
+			return groups;
+		}, new Map<string, any[]>())
+	).map(([category, group]) => ({ category, items: group }));
+
+	function categoryFor(item: any): string {
+		return String(item.category || item.group || item.tags?.[0] || 'OSagent 插件');
+	}
+
+	function displayName(item: any): string {
+		return String(item.display_name || item.name || 'Plugin');
+	}
+
+	function iconTone(item: any): string {
+		const value = categoryFor(item).toLowerCase();
+		if (value.includes('文件') || value.includes('文档'))
+			return 'bg-blue-100 text-blue-700 dark:bg-blue-950/60 dark:text-blue-300';
+		if (value.includes('浏览') || value.includes('网页'))
+			return 'bg-cyan-100 text-cyan-700 dark:bg-cyan-950/60 dark:text-cyan-300';
+		if (value.includes('数据') || value.includes('表'))
+			return 'bg-emerald-100 text-emerald-700 dark:bg-emerald-950/60 dark:text-emerald-300';
+		if (value.includes('自动') || value.includes('任务'))
+			return 'bg-amber-100 text-amber-700 dark:bg-amber-950/60 dark:text-amber-300';
+		return 'bg-gray-100 text-gray-700 dark:bg-gray-800 dark:text-gray-200';
+	}
+
+	function connectorFor(item: any): any | null {
+		return item?.connectors?.[0] ?? null;
+	}
+
+	function connectionFor(item: any): any | null {
+		const connector = connectorFor(item);
+		if (!connector) return null;
+		return (
+			toolConnections.find(
+				(connection) => connection?.type === 'mcp' && connection?.info?.id === connector.id
+			) ?? null
+		);
+	}
+
+	function toolFor(item: any): any | null {
+		const connector = connectorFor(item);
+		if (!connector) return null;
+		return availableTools.find((tool) => tool.id === `server:mcp:${connector.id}`) ?? null;
+	}
+
+	function runtimeState(item: any): string {
+		if (!item.enabled) return 'disabled';
+		if (item.runtime_status === 'unsupported') return 'unsupported';
+		const connector = connectorFor(item);
+		if (!connector) return item.invocation_available ? 'ready' : 'unsupported';
+		if (!integrationsReady) return 'checking';
+		const connection = connectionFor(item);
+		if (!connection) return 'connection_required';
+		if (connection?.config?.enable === false) return 'disabled';
+		if (connector.auth_type === 'oauth_2.1' && toolFor(item)?.authenticated !== true) {
+			return 'authorization_required';
+		}
+		return 'ready';
+	}
+
+	function runtimeLabel(item: any): string {
+		const labels: Record<string, string> = {
+			checking: '检查连接',
+			ready: '可使用',
+			connection_required: '需要连接',
+			authorization_required: '需要授权',
+			disabled: '已禁用',
+			unsupported: '暂不兼容'
+		};
+		return labels[runtimeState(item)] ?? '状态未知';
+	}
+
+	function statusTone(item: any): string {
+		const state = runtimeState(item);
+		if (state === 'ready') return 'bg-emerald-500';
+		if (state === 'connection_required' || state === 'authorization_required')
+			return 'bg-amber-500';
+		if (state === 'unsupported') return 'bg-red-400';
+		return 'bg-gray-300 dark:bg-gray-600';
+	}
+
+	function lifecycleOperation(item: any): string {
+		return item.enabled ? 'disable' : 'enable';
+	}
+
+	function lifecycleLabel(item: any): string {
+		return busy === `${item.name}:${lifecycleOperation(item)}`
+			? '处理中'
+			: item.enabled
+				? '禁用'
+				: '启用';
+	}
+
+	const headers = () => {
+		const value = apiKey || localStorage.getItem('osagent-service-key') || '';
+		return value ? { Authorization: `Bearer ${value}` } : {};
+	};
+
+	async function request(path: string, options: RequestInit = {}) {
+		const response = await fetch(`/osagent${path}`, {
+			...options,
+			headers: { ...headers(), ...(options.headers || {}) }
+		});
+		const payload = await response.json().catch(() => ({ ok: false, error: response.statusText }));
+		if (response.status === 401) {
+			needsKey = true;
+			showSettings = true;
+			throw new Error('OSagent 服务需要 API 密钥');
+		}
+		if (!response.ok || !payload.ok) throw new Error(payload.error || `HTTP ${response.status}`);
+		return payload.data;
+	}
+
+	async function load() {
+		loading = true;
+		try {
+			const data = await request(`/v1/plugins?query=${encodeURIComponent(query)}`);
+			items = data?.plugins ?? [];
+			needsKey = false;
+		} catch (error) {
+			if (!needsKey) toast.error(String(error));
+		} finally {
+			loading = false;
+		}
+	}
+
+	async function loadIntegrations() {
+		integrationsReady = false;
+		try {
+			const config = await getToolServerConnections(localStorage.token);
+			toolConnections = config?.TOOL_SERVER_CONNECTIONS ?? [];
+			canManageConnections = true;
+			integrationsReady = true;
+		} catch {
+			toolConnections = [];
+			canManageConnections = false;
+		}
+		try {
+			availableTools = (await getTools(localStorage.token)) ?? [];
+		} catch {
+			availableTools = [];
+		}
+	}
+
+	async function refreshAll() {
+		await Promise.all([load(), loadIntegrations()]);
+	}
+
+	function onQueryInput() {
+		if (searchTimer) clearTimeout(searchTimer);
+		searchTimer = setTimeout(load, 250);
+	}
+
+	async function run(item: any, operation: string) {
+		busy = `${item.name}:${operation}`;
+		try {
+			const path =
+				operation === 'install'
+					? `/v1/plugins/${encodeURIComponent(item.name)}/install`
+					: operation === 'uninstall'
+						? `/v1/plugins/${encodeURIComponent(item.name)}`
+						: `/v1/plugins/${encodeURIComponent(item.name)}/${operation}`;
+			await request(path, { method: operation === 'uninstall' ? 'DELETE' : 'POST', body: '{}' });
+			const connectorIds = (item.connectors ?? []).map((connector: any) => connector.id);
+			if (connectorIds.length && canManageConnections) {
+				if (operation === 'uninstall') {
+					toolConnections = toolConnections.filter(
+						(connection) => !connectorIds.includes(connection?.info?.id)
+					);
+				} else if (operation === 'enable' || operation === 'disable') {
+					toolConnections = toolConnections.map((connection) =>
+						connectorIds.includes(connection?.info?.id)
+							? {
+									...connection,
+									config: { ...(connection.config ?? {}), enable: operation === 'enable' }
+								}
+							: connection
+					);
+				}
+				await setToolServerConnections(localStorage.token, {
+					TOOL_SERVER_CONNECTIONS: toolConnections
+				});
+			}
+			await refreshAll();
+			const labels: Record<string, string> = {
+				install: '已安装',
+				enable: '已启用',
+				disable: '已禁用',
+				uninstall: '已卸载'
+			};
+			toast.success(`${item.name} ${labels[operation] || operation}`);
+		} catch (error) {
+			toast.error(String(error));
+		} finally {
+			busy = '';
+		}
+	}
+
+	function toolId(item: any): string {
+		const connector = connectorFor(item);
+		return connector ? `server:mcp:${connector.id}` : '';
+	}
+
+	async function usePlugin(item: any) {
+		const connector = connectorFor(item);
+		if (!connector) {
+			toast.info('该插件提供声明式能力，Agent 会在需要时加载它的说明。');
+			return;
+		}
+		const state = runtimeState(item);
+		if (state === 'ready') {
+			await goto(`/?tools=${encodeURIComponent(toolId(item))}`);
+			return;
+		}
+		if (!canManageConnections) {
+			toast.error('连接 MCP 插件需要 Open WebUI 管理员权限');
+			return;
+		}
+
+		busy = `${item.name}:connect`;
+		try {
+			let connection = connectionFor(item);
+			if (!connection) {
+				let oauthClientInfo: string | null = null;
+				const draft = {
+					url: connector.url,
+					path: '',
+					type: 'mcp',
+					auth_type: connector.auth_type ?? 'none',
+					headers: null,
+					key: null,
+					config: { enable: true, access_grants: [] },
+					info: {
+						id: connector.id,
+						name: displayName(item),
+						description: item.description ?? '',
+						oauth_resource_parameter: 'auto',
+						...(connector.oauth_scope ? { oauth_scope: connector.oauth_scope } : {})
+					}
+				};
+
+				await verifyToolServerConnection(localStorage.token, draft);
+				if (connector.auth_type === 'oauth_2.1') {
+					const registration = await registerOAuthClient(
+						localStorage.token,
+						{
+							url: connector.url,
+							client_id: connector.id,
+							client_name: `OSagent ${displayName(item)}`,
+							...(connector.oauth_scope ? { oauth_scope: connector.oauth_scope } : {})
+						},
+						'mcp'
+					);
+					oauthClientInfo = registration?.oauth_client_info ?? null;
+					if (!oauthClientInfo) throw new Error('OAuth 客户端注册失败');
+				}
+
+				connection = {
+					...draft,
+					info: {
+						...draft.info,
+						...(oauthClientInfo ? { oauth_client_info: oauthClientInfo } : {})
+					}
+				};
+				toolConnections = [
+					...toolConnections.filter((value) => value?.info?.id !== connector.id),
+					connection
+				];
+				await setToolServerConnections(localStorage.token, {
+					TOOL_SERVER_CONNECTIONS: toolConnections
+				});
+			}
+
+			await loadIntegrations();
+			if (connector.auth_type === 'oauth_2.1' && toolFor(item)?.authenticated !== true) {
+				toast.success('连接已保存，正在打开账户授权');
+				initiateOAuthRedirect({
+					id: toolId(item),
+					serverId: connector.id,
+					authType: 'mcp'
+				});
+				return;
+			}
+			toast.success(`${displayName(item)} 已连接`);
+			await goto(`/?tools=${encodeURIComponent(toolId(item))}`);
+		} catch (error) {
+			toast.error(`插件连接失败：${String(error)}`);
+		} finally {
+			busy = '';
+		}
+	}
+
+	function useLabel(item: any): string {
+		if (busy === `${item.name}:connect`) return '连接中';
+		const state = runtimeState(item);
+		if (state === 'checking') return '检查中';
+		if (state === 'ready') return '在对话中使用';
+		if (state === 'authorization_required') return '继续授权';
+		if (state === 'connection_required') return '连接';
+		if (item.invocation_available) return '使用说明';
+		return '不可用';
+	}
+
+	async function uninstall(item: any) {
+		if (window.confirm(`确定卸载 ${item.name} 吗？`)) await run(item, 'uninstall');
+	}
+
+	function saveKey() {
+		localStorage.setItem('osagent-service-key', apiKey);
+		needsKey = false;
+		showSettings = false;
+		refreshAll();
+	}
+
+	onMount(() => {
+		void refreshAll();
+		// The workspace route can mount before Open WebUI restores the user token.
+		// Re-read host connections once after hydration to avoid duplicate OAuth registration.
+		integrationRetryTimer = setTimeout(() => void loadIntegrations(), 1000);
+		return () => {
+			if (integrationRetryTimer) clearTimeout(integrationRetryTimer);
+		};
+	});
+</script>
+
+<svelte:head>
+	<title>插件市场 / {$i18n.t('Workspace')}</title>
+</svelte:head>
+
+<div class="mx-auto w-full max-w-6xl px-2 pb-16 pt-4 md:px-8 md:pt-6">
+	<div
+		class="flex flex-wrap items-center justify-end gap-3 border-b border-gray-100 pb-3 dark:border-gray-800"
+	>
+		<div class="flex items-center gap-1.5">
+			<button
+				class="rounded-lg p-2 text-gray-500 transition hover:bg-gray-100 hover:text-gray-900 disabled:opacity-50 dark:hover:bg-gray-800"
+				title="刷新"
+				aria-label="刷新"
+				disabled={loading}
+				on:click={refreshAll}
+			>
+				<Refresh class="size-4 {loading ? 'animate-spin' : ''}" />
+			</button>
+			<button
+				class="rounded-lg p-2 text-gray-500 transition hover:bg-gray-100 hover:text-gray-900 dark:hover:bg-gray-800"
+				title="插件市场设置"
+				aria-label="插件市场设置"
+				on:click={() => (showSettings = !showSettings)}
+			>
+				<Settings class="size-4" />
+			</button>
+			<details class="relative">
+				<summary
+					class="flex cursor-pointer list-none items-center gap-1 rounded-lg bg-gray-900 px-3 py-2 text-sm font-medium text-white transition hover:bg-gray-700 dark:bg-gray-100 dark:text-gray-900 dark:hover:bg-white"
+					><Plus class="size-4" /> 添加 <ChevronDown class="size-3.5" /></summary
+				>
+				<div
+					class="absolute right-0 z-20 mt-2 w-48 overflow-hidden rounded-xl border border-gray-200 bg-white py-1 shadow-xl dark:border-gray-700 dark:bg-gray-900"
+				>
+					<a
+						class="block px-3 py-2 text-sm hover:bg-gray-50 dark:hover:bg-gray-800"
+						href="/workspace/tools">管理 Open WebUI 工具</a
+					>
+				</div>
+			</details>
+		</div>
+	</div>
+
+	<header class="mx-auto max-w-4xl pb-2 pt-10 text-center md:pt-14">
+		<h1 class="text-3xl font-semibold tracking-tight text-gray-900 dark:text-gray-100 md:text-4xl">
+			插件
+		</h1>
+		<p class="mt-2 text-sm text-gray-500 dark:text-gray-400">
+			在 OSagent 中安装并管理可复用的工作能力
+		</p>
+		<div class="relative mt-7">
+			<Search
+				class="pointer-events-none absolute left-4 top-1/2 size-4 -translate-y-1/2 text-gray-400"
+			/>
+			<input
+				class="w-full rounded-2xl border border-gray-200 bg-transparent py-3 pl-11 pr-4 text-sm outline-none transition focus:border-gray-400 focus:ring-2 focus:ring-gray-200 dark:border-gray-700 dark:focus:border-gray-500 dark:focus:ring-gray-800"
+				placeholder="搜索插件、能力或权限"
+				aria-label="搜索插件"
+				bind:value={query}
+				on:input={onQueryInput}
+			/>
+		</div>
+	</header>
+
+	{#if showSettings}
+		<section
+			class="mx-auto mt-5 flex max-w-4xl flex-wrap items-center gap-3 rounded-xl border border-gray-200 bg-gray-50 p-3 text-sm dark:border-gray-800 dark:bg-gray-900/60"
+			aria-label="OSagent settings"
+		>
+			<div class="flex-1">
+				<div class="font-medium text-gray-900 dark:text-gray-100">OSagent 服务连接</div>
+				<div class="mt-0.5 text-xs text-gray-500">API 密钥仅保存在当前浏览器的本地存储中</div>

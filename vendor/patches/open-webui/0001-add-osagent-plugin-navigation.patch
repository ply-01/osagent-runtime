--- a/backend/open_webui/main.py
+++ b/backend/open_webui/main.py
@@ -571,6 +571,57 @@ async def initialize_runtime_config(app: FastAPI):
     from open_webui.utils.access_control import migrate_access_control
 
     connections = await Config.get('tool_server.connections', []) or []
+    osagent_public_webui_url = os.getenv('OS_AGENT_PUBLIC_WEBUI_URL', '').strip().rstrip('/')
+    if osagent_public_webui_url:
+        await Config.upsert({'webui.url': osagent_public_webui_url})
+
+    osagent_url = os.getenv('OS_AGENT_MEMORY_URL', '').strip().rstrip('/')
+    osagent_key = os.getenv('OS_AGENT_MEMORY_API_KEY', '').strip()
+    osagent_auto_register = os.getenv('OS_AGENT_MCP_AUTO_REGISTER', 'true').lower() in {
+        '1',
+        'true',
+        'yes',
+        'on',
+    }
+    if osagent_auto_register and osagent_url and osagent_key:
+        managed_connection = {
+            'url': f'{osagent_url}/mcp',
+            'path': '',
+            'type': 'mcp',
+            'auth_type': 'bearer',
+            'headers': None,
+            'key': osagent_key,
+            'config': {'enable': True, 'access_grants': []},
+            'info': {
+                'id': 'osagent',
+                'name': 'OSagent Tools',
+                'description': 'OSagent memory and workspace tools',
+            },
+        }
+        existing_index = next(
+            (
+                index
+                for index, connection in enumerate(connections)
+                if connection.get('type', 'openapi') == 'mcp'
+                and (connection.get('info') or {}).get('id') == 'osagent'
+            ),
+            None,
+        )
+        if existing_index is None:
+            connections.append(managed_connection)
+        else:
+            existing = connections[existing_index]
+            managed_connection['config'] = {
+                **(existing.get('config') or {}),
+                'enable': True,
+            }
+            managed_connection['info'] = {
+                **(existing.get('info') or {}),
+                **managed_connection['info'],
+            }
+            connections[existing_index] = managed_connection
+        await Config.upsert({'tool_server.connections': connections})
+
     if any('access_control' in c.get('config', {}) for c in connections):
         for connection in connections:
             migrate_access_control(connection.get('config', {}))
